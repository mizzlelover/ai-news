name: Update Smart Tourism Snapshot

on:
  workflow_dispatch:
    inputs:
      force_tikhub:
        description: "Force a paid TikHub refresh even before its normal interval"
        required: false
        default: false
        type: boolean
  schedule:
    - cron: "*/30 * * * *"

concurrency:
  group: update-smart-tourism-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  update:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    timeout-minutes: 15
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: "pip"
          cache-dependency-path: "requirements.txt"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Prepare OPML
        env:
          FOLLOW_OPML_B64: ${{ secrets.FOLLOW_OPML_B64 }}
        run: |
          private_opml_dir="$RUNNER_TEMP/private-intelligence"
          private_opml="$private_opml_dir/follow.opml"
          mkdir -p "$private_opml_dir"
          if [ -n "$FOLLOW_OPML_B64" ]; then
            printf '%s' "$FOLLOW_OPML_B64" | base64 --decode > "$private_opml"
            test -s "$private_opml"
            echo "FOLLOW_OPML_PATH=$private_opml" >> "$GITHUB_ENV"
            echo "Loaded private OPML from runner temp"
          elif [ -f feeds/wisdom-tourism.opml ]; then
            echo "FOLLOW_OPML_PATH=$GITHUB_WORKSPACE/feeds/wisdom-tourism.opml" >> "$GITHUB_ENV"
            echo "Loaded smart tourism OPML"
          elif [ -f feeds/follow.example.opml ]; then
            echo "FOLLOW_OPML_PATH=$GITHUB_WORKSPACE/feeds/follow.example.opml" >> "$GITHUB_ENV"
            echo "Loaded public demo OPML"
          else
            echo "No OPML file available; RSS OPML is optional"
          fi

      - name: Update data
        env:
          EMAIL_DIGEST_ENABLED: ${{ secrets.EMAIL_DIGEST_ENABLED || vars.EMAIL_DIGEST_ENABLED }}
          AGENTMAIL_API_KEY: ${{ secrets.AGENTMAIL_API_KEY }}
          AGENTMAIL_INBOX_ID: ${{ secrets.AGENTMAIL_INBOX_ID }}
          AGENTMAIL_API_BASE_URL: ${{ vars.AGENTMAIL_API_BASE_URL }}
          AGENTMAIL_LIMIT: ${{ vars.AGENTMAIL_LIMIT }}
          AGENTMAIL_ALLOWED_SENDER_DOMAINS: ${{ vars.AGENTMAIL_ALLOWED_SENDER_DOMAINS }}
          # Paid X/social sources are optional in the smart-tourism profile.
          # Keys live in secrets; optional tuning variables override code defaults.
          # Policy is key-first: a key present => the source runs; ENABLED is
          # optional and only needs setting to 0 to force it off.
          X_API_ENABLED: ${{ secrets.X_API_ENABLED || vars.X_API_ENABLED }}
          X_BEARER_TOKEN: ${{ secrets.X_BEARER_TOKEN }}
          SOCIALDATA_ENABLED: ${{ secrets.SOCIALDATA_ENABLED || vars.SOCIALDATA_ENABLED }}
          SOCIALDATA_API_KEY: ${{ secrets.SOCIALDATA_API_KEY }}
          SOCIALDATA_QUERY: ${{ vars.SOCIALDATA_QUERY }}
          SOCIALDATA_SEARCH_TYPE: ${{ vars.SOCIALDATA_SEARCH_TYPE }}
          SOCIALDATA_MAX_RESULTS: ${{ vars.SOCIALDATA_MAX_RESULTS }}
          SOCIALDATA_DAILY_TWEET_LIMIT: ${{ vars.SOCIALDATA_DAILY_TWEET_LIMIT }}
          SOCIALDATA_RUN_INTERVAL_HOURS: ${{ vars.SOCIALDATA_RUN_INTERVAL_HOURS }}
          SOCIALDATA_RUN_UTC_HOUR: ${{ vars.SOCIALDATA_RUN_UTC_HOUR }}
          SOCIALDATA_RUN_UTC_MINUTE_MAX: ${{ vars.SOCIALDATA_RUN_UTC_MINUTE_MAX }}
          SOCIALDATA_LIST_ID: ${{ vars.SOCIALDATA_LIST_ID }}
          SOCIALDATA_LIST_ENABLED: ${{ vars.SOCIALDATA_LIST_ENABLED }}
          SOCIALDATA_LIST_MAX_RESULTS: ${{ vars.SOCIALDATA_LIST_MAX_RESULTS }}
          SOCIALDATA_LIST_EXCLUDE: ${{ vars.SOCIALDATA_LIST_EXCLUDE }}
          TIKHUB_ENABLED: ${{ secrets.TIKHUB_ENABLED || vars.TIKHUB_ENABLED }}
          TIKHUB_API_KEY: ${{ secrets.TIKHUB_API_KEY }}
          TIKHUB_API_BASE_URL: ${{ vars.TIKHUB_API_BASE_URL }}
          TIKHUB_QUERY: ${{ vars.TIKHUB_QUERY }}
          TIKHUB_PLATFORMS: ${{ vars.TIKHUB_PLATFORMS }}
          TIKHUB_MAX_RESULTS: ${{ vars.TIKHUB_MAX_RESULTS }}
          TIKHUB_DAILY_ITEM_LIMIT: ${{ vars.TIKHUB_DAILY_ITEM_LIMIT }}
          TIKHUB_RUN_INTERVAL_HOURS: ${{ vars.TIKHUB_RUN_INTERVAL_HOURS }}
          TIKHUB_RUN_UTC_HOUR: ${{ vars.TIKHUB_RUN_UTC_HOUR }}
          TIKHUB_RUN_UTC_MINUTE_MAX: ${{ vars.TIKHUB_RUN_UTC_MINUTE_MAX }}
          TIKHUB_FORCE_RUN: ${{ inputs.force_tikhub && '1' || '' }}
          RSS_MAX_FEEDS: ${{ vars.RSS_MAX_FEEDS || 40 }}
        run: |
          if [ -n "${FOLLOW_OPML_PATH:-}" ] && [ -f "$FOLLOW_OPML_PATH" ]; then
            python scripts/update_news.py --output-dir data --window-hours 24 --archive-days 21 --rss-opml "$FOLLOW_OPML_PATH" --rss-max-feeds "${RSS_MAX_FEEDS:-40}" --translate-max-new 0 --source-profile smart-tourism
          else
            python scripts/update_news.py --output-dir data --window-hours 24 --archive-days 21 --translate-max-new 0 --source-profile smart-tourism
          fi

      - name: Commit and push changes
        env:
          EMAIL_DIGEST_PUBLISH: ${{ secrets.EMAIL_DIGEST_PUBLISH || vars.EMAIL_DIGEST_PUBLISH }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          # Stage the whole data dir so newly added output files can never be
          # silently dropped again (the daily-brief/stories-merged freeze was
          # caused by a stale filename whitelist here). .gitignore keeps
          # data/email-digest.json out of this add.
          git add data/
          if [ -f data/email-digest.json ] && [ "$EMAIL_DIGEST_PUBLISH" = "1" ]; then
            git add -f data/email-digest.json
          fi
          # Self-check: fail loudly if anything under data/ is still unstaged,
          # instead of green-but-stale runs.
          if [ -n "$(git status --porcelain --untracked-files=all -- data/ | grep -v '^[MADRC]' || true)" ]; then
            echo "::error::Generated files under data/ were not staged:"
            git status --porcelain --untracked-files=all -- data/ | grep -v '^[MADRC]'
            exit 1
          fi
          if git diff --cached --quiet; then
            echo "No changes to commit"
            exit 0
          fi
          git commit -m "chore: update smart tourism snapshot"
          git push

      - name: Prepare static site
        run: |
          mkdir _site
          git archive --format=tar HEAD \
            index.html .nojekyll LICENSE NOTICE.md README.md README.en.md demo \
            | tar -x -C _site
          git archive --format=tar HEAD \
            data/daily-brief.json data/latest-24h-all.json data/latest-24h.json \
            data/merge-log.json data/source-status.json data/stories-merged.json \
            data/title-zh-cache.json data/waytoagi-7d.json \
            feeds/follow.example.opml feeds/social-x.example.opml \
            feeds/wechat.example.opml feeds/wisdom-tourism.opml \
            | tar -x -C _site
          find _site -type f -name ".DS_Store" -delete
          test ! -e _site/data/archive.json
          test ! -e _site/data/email-digest.json
          test ! -e _site/data/paid-source-state.json
          test ! -e _site/feeds/follow.opml

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
